{
  "name": "hair-atelier-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check:sw": "node --check public/sw.js && node Tools/test_service_worker.mjs",
    "check:pwa": "node Tools/check_pwa.mjs",
    "check:bundle": "node Tools/check_bundle.mjs",
    "check:browser": "node Tools/browser_smoke.mjs",
    "check:offline-build": "node Tools/check_offline_build.mjs",
    "check:offline-browser": "node Tools/first-visit-offline-smoke.mjs",
    "check:offline-upgrade": "node Tools/service-worker-update-smoke.mjs",
    "check": "npm run test && npm run check:sw && npm run check:pwa && npm run build && npm run check:offline-build && npm run check:bundle",
    "check:context-browser": "node Tools/webgl-context-smoke.mjs",
    "check:startup-browser": "node Tools/webgl-startup-smoke.mjs",
    "check:offline-readiness": "node Tools/offline-readiness-smoke.mjs",
    "check:multitouch-browser": "node Tools/multitouch-ownership-smoke.mjs",
    "check:offline-registration": "node Tools/offline-registration-smoke.mjs",
    "check:legacy-race": "node Tools/legacy-localstorage-race-smoke.mjs",
    "check:legacy-insecure": "node Tools/legacy-insecure-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
